rules_version = '2';

// ทุกการอ่าน/เขียนต้องผ่าน API Routes (Firebase Admin SDK) เท่านั้น
// Admin SDK ไม่ถูกบังคับด้วย Rules นี้ ส่วน client SDK จะถูกปฏิเสธทั้งหมด
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
