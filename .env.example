# ---------- แอป ----------
# URL ของเว็บหลัง deploy (ไม่มี / ต่อท้าย)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# ---------- LINE Messaging API (channel ของ LINE OA) ----------
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# ---------- LINE Login + LIFF ----------
# Channel ID ของ LINE Login channel (ใช้ตรวจ ID Token ฝั่งเซิร์ฟเวอร์)
LINE_LOGIN_CHANNEL_ID=
# LIFF ID เช่น 1234567890-AbCdEfGh (Endpoint URL = NEXT_PUBLIC_APP_URL)
NEXT_PUBLIC_LIFF_ID=

# ---------- Firebase Admin (Service Account) ----------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# ใส่ทั้งก้อนในเครื่องหมายคำพูด และคง \n ไว้ตามไฟล์ JSON
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# เช่น your-project.firebasestorage.app
FIREBASE_STORAGE_BUCKET=

# ---------- AI ผู้ช่วย (Google Gemini — มี free tier) ----------
# สร้างคีย์ฟรีที่ https://aistudio.google.com/apikey
GEMINI_API_KEY=
# ชื่อโมเดล ดูรายการที่ใช้ได้ใน AI Studio ถ้าไม่ตั้งจะใช้ gemini-flash-latest
GEMINI_MODEL=gemini-flash-latest
# จำนวนคำถามสูงสุดต่อคนต่อวัน
AI_DAILY_LIMIT=20
# true = ให้ AI แต่งหัวข้อแจ้งเตือนแนวเกม (1 คำขอต่อห้องต่อรอบแจ้งเตือน)
AI_NOTIFY_ENABLED=true

# ---------- Vercel Cron ----------
# สุ่มค่ายาวๆ เช่น: openssl rand -hex 32
CRON_SECRET=
